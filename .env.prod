# Natyakosha — prod environment. Values are read at startup by flutter_dotenv.
APP_NAME=Natyakosha
ENV=prod
# Base URL of your Cloud Functions / REST API (used by the Dio client)
API_BASE_URL=https://asia-south1-YOUR_PROJECT_ID.cloudfunctions.net
API_TIMEOUT_MS=20000
# Log HTTP + Redux actions to the console
ENABLE_LOGS=false
# Image compression before upload
IMAGE_MAX_DIMENSION=1600
IMAGE_QUALITY=70
