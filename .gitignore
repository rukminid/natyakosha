# Firebase config generated by `flutterfire configure`.
# lib/firebase_options.dart is committed as a placeholder (the app imports it).
# After you run `flutterfire configure`, decide whether to keep these in the repo:
# android/app/google-services.json
# ios/Runner/GoogleService-Info.plist

# Real env values. .env.dev / .env.staging / .env.prod are bundled as app assets and
# currently hold placeholders only. Put real secrets in untracked *.local files,
# or uncomment these three lines once they contain anything private.
# .env.dev
# .env.staging
# .env.prod
.env.local
.env.*.local
